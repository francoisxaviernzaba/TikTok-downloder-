# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- TikTok resolver hardening (all optional; sane defaults shown) ---
# Comma-separated resolver order. Available: direct, tiktokdl, tikwm, tikly, lovetik,
# plus any names you define in RESOLVER_GENERIC.
# RESOLVERS="direct,tiktokdl,tikwm,tikly,lovetik"
# Per-fetch timeout (ms) for each resolver
# RESOLVER_TIMEOUT_MS="8000"
# Overall budget (ms) per resolver in the chain (defaults to 2x RESOLVER_TIMEOUT_MS + 2000)
# RESOLVER_MAX_MS="18000"
# Override provider endpoints without code changes
# RESOLVER_TIKWM_URL="https://tikwm.com/api/"
# RESOLVER_TIKLY_URL="https://tiklydown.eu.org/api/download"
# RESOLVER_LOVETIK_URL="https://lovetik.com/api/ajax/search"
# RESOLVER_TIKTOKDL_URL="https://tiktokdownload.online/api/download"
# Extra media hosts to trust for provider-returned URLs (comma-separated)
# ALLOWED_MEDIA_HOSTS="example-cdn.com"
# Many public APIs via JSON array: {name,url,method?,body?,contentType?,headers?}
# {url} = URL-encoded target; for POST bodies {url} is raw and {urlenc} is encoded.
# RESOLVER_GENERIC='[{"name":"foo","url":"https://api.foo.com/download?url={url}"},{"name":"bar","url":"https://api.bar.com/api","method":"POST","body":"url={url}","contentType":"application/x-www-form-urlencoded"}]'
# Resolution cache (in-memory, per instance)
# CACHE_TTL_SECONDS="1500"
# NEGATIVE_TTL_SECONDS="60"
# CACHE_MAX_ENTRIES="5000"

# ===== TikTok Downloader Resilience Configuration =====

# Cache TTL for successful resolutions (seconds). Default: 1500 (25 min, just under CDN expiry).
CACHE_TTL_SECONDS=1500

# Negative cache TTL for failed resolutions (seconds). Default: 60 (1 min).
NEGATIVE_TTL_SECONDS=60

# Maximum cache entries (positive + negative). Default: 5000.
CACHE_MAX_ENTRIES=5000

# Per-resolver timeout (milliseconds). Default: 8000.
RESOLVER_TIMEOUT_MS=8000

# Comma-separated list of enabled resolvers (in order).
# Available: tikwm, tikly, lovetik, direct
# Default: all four in order (tikwm,tikly,lovetik,direct)
# Example: RESOLVERS=tikly,lovetik,direct  (excludes TikWM)
RESOLVERS=tikwm,tikly,lovetik,direct

# Optional per-resolver base URL overrides (useful when providers rotate domains).
# RESOLVER_TIKWM_URL=https://tikwm.com/api/
# RESOLVER_TIKLY_URL=https://tiklydown.eu.org/api/download
# RESOLVER_LOVETIK_URL=https://lovetik.com/api/ajax/search