{
  "manifest_version": 3,
  "name": "TikDownloader Helper",
  "version": "2.0.0",
  "description": "Download TikTok videos without watermark, using your own IP. Adds a download button on TikTok pages.",
  "host_permissions": ["https://*.tiktok.com/*"],
  "content_scripts": [
    {
      "matches": ["https://*.tiktok.com/*"],
      "js": ["tiktok-page.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://tiktok-downloder-vuhs.onrender.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TikDownloader"
  }
}